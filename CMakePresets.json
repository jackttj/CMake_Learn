{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/superbuild/${presetName}"
    },
    {
      "name": "dev",
      "displayName": "All projects (Debug)",
      "description": "Build dependencies, Upstream, MyLib and Consumer",
      "inherits": "base",
      "cacheVariables": {
        "SUPERBUILD_VARIANT": "vs-debug",
        "SUPERBUILD_BUILD_CONFIG": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "All projects (Release)",
      "description": "Build dependencies, Upstream, MyLib and Consumer",
      "inherits": "base",
      "cacheVariables": {
        "SUPERBUILD_VARIANT": "vs-release",
        "SUPERBUILD_BUILD_CONFIG": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "Debug",
      "jobs": 0
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "jobs": 0
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "displayName": "Configure and build everything (Debug)",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" }
      ]
    },
    {
      "name": "release",
      "displayName": "Configure and build everything (Release)",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" }
      ]
    }
  ]
}
